# Copie para .env (local) ou cadastre na Vercel. Nunca faça commit do .env.

# Banco Postgres (Neon). Use a URL "pooled".
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Perfect Pay: segredo que vai na URL do webhook (?key=...)
PERFECTPAY_WEBHOOK_SECRET=troque-por-um-valor-aleatorio
# Opcional: token que a Perfect Pay manda no payload/cabeçalho (se houver)
PERFECTPAY_TOKEN=

# Protege /api/cron/dispatch
CRON_SECRET=troque-por-um-valor-aleatorio

# Login do painel
ADMIN_EMAIL=voce@exemplo.com
# Gere com: npm run hash-password -- 'sua senha'  (no .env local, cada $ precisa virar \$)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Remetente e contato
EMAIL_FROM_NAME=Nathan Miller
EMAIL_FROM_ADDRESS=nathan@seudominio.com
EMAIL_REPLY_TO=suporte@seudominio.com
SUPPORT_EMAIL=suporte@seudominio.com
SUPPORT_WHATSAPP_URL=
POSTAL_ADDRESS=Endereço postal completo, Cidade, Estado, CEP, País

# URL pública do app (sem barra no final)
APP_BASE_URL=https://seu-app.vercel.app

# true = simulação (nada é enviado). Só troque para false depois do checklist.
DRY_RUN=true

# Opcional: destino do botão "enviar teste para mim" (padrão: ADMIN_EMAIL)
TEST_EMAIL_TO=
